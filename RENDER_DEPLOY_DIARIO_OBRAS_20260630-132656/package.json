{
  "name": "diario-obra-itauba",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "api": "node --env-file-if-exists=.env server/server.mjs",
    "dev": "vite",
    "dev:all": "node server/dev-runner.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/server.mjs",
    "test:e2e": "playwright test",
    "ops:pilot": "node --env-file-if-exists=.env server/cli/pilot.mjs",
    "test:db": "node --env-file-if-exists=.env --test tests/integration/postgres.integration.mjs",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.mjs",
    "ops:restore-check": "node --env-file-if-exists=.env server/cli/restore-check.mjs",
    "ops:backup": "node --env-file-if-exists=.env server/cli/backup.mjs",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "pg": "8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "6.1.2",
    "supabase": "2.121.0",
    "vite": "8.3.5"
  }
}
